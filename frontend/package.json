{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "check": "tsc -b && npm run lint && vite build && vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/api/generated/schema.d.ts",
    "record:replay": "node scripts/record-replay.mjs"
  },
