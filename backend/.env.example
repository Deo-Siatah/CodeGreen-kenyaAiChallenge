# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored - never commit real credentials.

APP_NAME="AgriForesight API"

# Postgres (Neon)
# DATABASE_URL_POOLED is for the application. It is the pooled connection string,
# which routes through transaction-mode PgBouncer. Use this everywhere in app code.
# DATABASE_URL_DIRECT is the direct connection string. Alembic uses this ONLY,
# because transaction-mode pooling breaks migrations that need session state
# (advisory locks, SET search_path, CREATE INDEX CONCURRENTLY).


# Keep this null unless EARTH_ENGINE_SERVICE_ACCOUNT_JSON is a valid reachable
# service-account key path; the real provider authenticates during app startup.
FARM_ACTIVITY_PROVIDER=null
EARTH_ENGINE_SERVICE_ACCOUNT_JSON=backend/secrets/hifadhi-earth-engine-1341b9bc4192.json

# Comma-separated origins are supported, for example:
# http://localhost:5173,https://frontend.example.com
ALLOWED_ORIGINS=https://hifadhi-app-neon.vercel.app

# Neon roles: a least-privilege role per workload. Alembic's direct connection
# needs its own DDL-capable role - do not reuse the scoring role for migrations.
DB_SCORING_ROLE="app_scoring"
DB_ANALYTICS_ROLE="app_analytics"

# Neo4j - DEPRECATED, remove after Postgres migration is verified in production
NEO4J_URI="neo4j+s://XXXXXXXX.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

USSD_WEBHOOK_URL="https://example.com/api/ussd/callback"
SMS_WEBHOOK_URL="https://example.com/api/sms/callback"
BACKEND_URL="http://localhost:8000"

AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME="sandbox"

GEMINI_API_KEY="jsjsj"
GEMINI_MODEL=gemini-3.5-flash
